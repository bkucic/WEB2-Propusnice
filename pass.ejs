<!DOCTYPE html>
<head>
    <title>Passes</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Document</th>
                <th>Issued at</th>
                <th>Status</th>
            </tr>
        </thead>
    
        <tbody>
            <tr>
                <td><%= pass.id %></td>
                <td><%= pass.name %></td>
                <td><%= pass.document %></td>
                <td><%= pass.issued_at.toISOString() %></td>
                <td><%= pass.status %></td>
            </tr>
        </tbody>
    </table>
</body>